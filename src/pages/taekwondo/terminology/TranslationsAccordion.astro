---
import type { MarkdownInstance } from 'astro'

import AccordionItem from '@components/AccordionItem.astro'

const tables = Object.values(
    import.meta.glob<MarkdownInstance<{ title: string }>>(
        '/src/content/terminology/*.{md,mdx}',
        { eager: true },
    ),
)
---

<div
    class="max-w-screen-lg prose prose-table:w-full hover:prose-tr:bg-slate-100"
    data-accordion="collapse"
>
    {
        tables.map((table, index) => (
            <AccordionItem
                title={table.frontmatter.title}
                isFirst={index === 0}
                isLast={index === tables.length - 1}
            >
                <table.Content />
            </AccordionItem>
        ))
    }
</div>
